[
  {
    "name": "project_get",
    "description": "The shared project: topics, members, current plan and instruction. Read before emitting.",
    "input_schema": {
      "properties": {
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "title": "project_getArguments",
      "type": "object"
    }
  },
  {
    "name": "project_list",
    "description": "Projects you belong to.",
    "input_schema": {
      "properties": {},
      "title": "project_listArguments",
      "type": "object"
    }
  },
  {
    "name": "project_create",
    "description": "Create a project (you become its initiator). Members by name.",
    "input_schema": {
      "$defs": {
        "TopicSpec": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "description": {
              "title": "Description",
              "type": "string"
            }
          },
          "required": [
            "name",
            "description"
          ],
          "title": "TopicSpec",
          "type": "object"
        }
      },
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/TopicSpec"
          },
          "title": "Topics",
          "type": "array"
        },
        "plan": {
          "default": "",
          "title": "Plan",
          "type": "string"
        },
        "instruction": {
          "default": "",
          "title": "Instruction",
          "type": "string"
        },
        "members": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Members"
        },
        "org": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Org"
        }
      },
      "required": [
        "name",
        "topics"
      ],
      "title": "project_createArguments",
      "type": "object"
    }
  },
  {
    "name": "project_members",
    "description": "Add members by name (initiator only).",
    "input_schema": {
      "properties": {
        "members": {
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "required": [
        "members"
      ],
      "title": "project_membersArguments",
      "type": "object"
    }
  },
  {
    "name": "topic_create",
    "description": "Add a topic (initiator only).",
    "input_schema": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "topic_createArguments",
      "type": "object"
    }
  },
  {
    "name": "topic_update",
    "description": "Rename, describe, close or reopen a topic (initiator only). Deleting is done by the person.",
    "input_schema": {
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "closed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "required": [
        "topic"
      ],
      "title": "topic_updateArguments",
      "type": "object"
    }
  },
  {
    "name": "project_request_update",
    "description": "Ask the central runner to rewrite the plan and instruction from new signals (initiator only, one run at a time).",
    "input_schema": {
      "properties": {
        "note": {
          "default": "",
          "description": "What the update should take into account, at most 240 characters",
          "maxLength": 240,
          "title": "Note",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "title": "project_request_updateArguments",
      "type": "object"
    }
  },
  {
    "name": "project_history",
    "description": "Versions of the project's plan and instruction, and which signals led to each.",
    "input_schema": {
      "properties": {
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "title": "project_historyArguments",
      "type": "object"
    }
  },
  {
    "name": "signal_emit",
    "description": "Emit signals to the team: one topic per signal; topics and approvers by name. Returns accepted, rejected (with why) or queued per signal.",
    "input_schema": {
      "$defs": {
        "SignalDraft": {
          "additionalProperties": false,
          "description": "One signal as the agent writes it.",
          "properties": {
            "kind": {
              "enum": [
                "DECISION",
                "CONSTRAINT",
                "REQUIREMENT",
                "QUESTION",
                "ANSWER",
                "STATUS",
                "NOTE"
              ],
              "title": "Kind",
              "type": "string"
            },
            "topic": {
              "description": "Topic name (or tp_ id); exactly one per signal",
              "title": "Topic",
              "type": "string"
            },
            "title": {
              "description": "The point itself, at most 120 characters",
              "title": "Title",
              "type": "string"
            },
            "summary": {
              "description": "At most 240 characters",
              "title": "Summary",
              "type": "string"
            },
            "points": {
              "description": "1-7 key points, each at most 150 characters",
              "items": {
                "type": "string"
              },
              "title": "Points",
              "type": "array"
            },
            "why": {
              "default": "",
              "title": "Why",
              "type": "string"
            },
            "refs": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Refs",
              "type": "array"
            },
            "supersedes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The newest sg_ id in the chain this replaces",
              "title": "Supersedes"
            },
            "approvers": {
              "default": [],
              "description": "Names of people asked to approve; empty for none",
              "items": {
                "type": "string"
              },
              "title": "Approvers",
              "type": "array"
            },
            "required": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Approvals needed; default all approvers",
              "title": "Required"
            },
            "due": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "ISO date-time the approval is due",
              "title": "Due"
            }
          },
          "required": [
            "kind",
            "topic",
            "title",
            "summary",
            "points"
          ],
          "title": "SignalDraft",
          "type": "object"
        }
      },
      "properties": {
        "signals": {
          "items": {
            "$ref": "#/$defs/SignalDraft"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "signals"
      ],
      "title": "signal_emitArguments",
      "type": "object"
    }
  },
  {
    "name": "signal_get",
    "description": "One signal, word for word, by sg_ id.",
    "input_schema": {
      "properties": {
        "signal": {
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal"
      ],
      "title": "signal_getArguments",
      "type": "object"
    }
  },
  {
    "name": "signal_list",
    "description": "Search the project's signals by topic, kind, state or text.",
    "input_schema": {
      "$defs": {
        "SignalKind": {
          "enum": [
            "DECISION",
            "CONSTRAINT",
            "REQUIREMENT",
            "QUESTION",
            "ANSWER",
            "STATUS",
            "NOTE",
            "APPROVE",
            "REJECT",
            "ARTIFACT",
            "ACTION_RESULT",
            "ACTION_REVOKE"
          ],
          "title": "SignalKind",
          "type": "string"
        },
        "SignalState": {
          "enum": [
            "IN_FORCE",
            "PENDING",
            "REJECTED",
            "SUPERSEDED"
          ],
          "title": "SignalState",
          "type": "string"
        }
      },
      "properties": {
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in_force_only": {
          "default": false,
          "title": "In Force Only",
          "type": "boolean"
        },
        "query": {
          "default": "",
          "title": "Query",
          "type": "string"
        },
        "after": {
          "default": 0,
          "title": "After",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "title": "Limit",
          "type": "integer"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "title": "signal_listArguments",
      "type": "object"
    }
  },
  {
    "name": "signal_cite",
    "description": "Record that this session relies on these sg_ ids; you will be told if they are superseded.",
    "input_schema": {
      "properties": {
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "signals"
      ],
      "title": "signal_citeArguments",
      "type": "object"
    }
  },
  {
    "name": "artifact_write",
    "description": "Store work teammates will rely on (a spec, data, code, a PDF, an image…) as a project artifact: a file (path) or text (content), with a real summary and key points. Topics and approvers by name; supersedes the newest version's id to publish a new version. Any type of file up to 5 MB is stored; larger ones are refused: publish a link with artifact_publish.",
