          "title": "Title"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "approvers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approvers"
        }
      },
      "required": [
        "topic",
        "summary"
      ],
      "title": "artifact_writeArguments",
      "type": "object"
    }
  },
