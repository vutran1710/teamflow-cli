      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "save_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Save To"
        },
        "exact_version": {
          "default": false,
          "title": "Exact Version",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "artifact_getArguments",
      "type": "object"
    }
