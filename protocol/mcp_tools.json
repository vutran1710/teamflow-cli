  {
    "name": "deliverables_get",
    "description": "The project's Deliverables: milestones in order, each action with its id, topic, due, owner, status (NOT_STARTED, IN_PROGRESS, BLOCKED, DONE) and whether it is late or yours.",
    "input_schema": {
      "properties": {},
      "title": "deliverables_getArguments",
      "type": "object"
    }
  },
  {
    "name": "deliverables_validate",
    "description": "Check a whole Deliverables structure (as deliverables_publish takes it) without publishing: every problem, or valid. The same check the server runs.",
    "input_schema": {
      "$defs": {
        "ActionSpec": {
          "additionalProperties": false,
          "description": "An action as submitted. A new one has no id; an existing one keeps its id (and its results and done).",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "pattern": "^ai_[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Id"
            },
            "name": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "topic": {
              "maxLength": 60,
              "minLength": 1,
              "title": "Topic",
              "type": "string"
            },
            "due": {
              "format": "date",
              "title": "Due",
              "type": "string"
            },
            "owner": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Owner"
            },
            "after": {
